<style>
  .custom-card-title {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 2.0rem !important;
    font-weight: normal !important;
    margin-top: 0px !important;
    margin-bottom: 12px !important;
    color: var(--global-text-color) !important;
    letter-spacing: -0.5px !important;
  }
  
  .custom-card-text {
    line-height: 1.3 !important;
    font-size: 1rem !important;
    font-weight: 350 !important;
    text-align: left !important;
    color: var(--global-text-color) !important;
    margin-bottom: 20px !important;
  }
</style>

<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable zoomable" style="overflow: hidden !important; border-radius: 6px !important;">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title custom-card-title">{{ project.title }}</h2>
        <p class="card-text custom-card-text">{{ project.description }}</p>
        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
